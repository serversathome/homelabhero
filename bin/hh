#!/usr/bin/env bash
#
# hh - HomelabHero control CLI.
#
# Agent-safe (read-only, used by Claude): list, run, test, overview, inventory,
#   scan, doctor, and the read ops of unifi, firewalla, netbird and cloudflare.
# Agent-capable but permission-gated: the WRITE ops of netbird and cloudflare.
#   Those two integrations can change things; unifi and firewalla cannot, by
#   construction, and that is deliberate - see their brokers.
# Operator (need sudo, run from an admin shell): add-host, add-unifi,
#   add-firewalla, add-netbird, add-cloudflare, rm-host, repin, update, login.
#
set -euo pipefail

HH_VERSION="1.5.0"
REG_DIR="/etc/homelabhero/hosts.d"
VAULT_DIR="/etc/homelabhero/vault"
# Pristine copy of the ops files HomelabHero ships, as last delivered. Diffing
# the live ops brain against it is what "have I edited this" means.
SHIPPED_DIR="/etc/homelabhero/shipped"
VAULT_USER="hhvault"
AGENT_USER="hhagent"
BROKER="/usr/local/bin/hh-connect"
UNIFI_BROKER="/usr/local/bin/hh-unifi"
FW_BROKER="/usr/local/bin/hh-firewalla"
NB_BROKER="/usr/local/bin/hh-netbird"
CF_BROKER="/usr/local/bin/hh-cloudflare"
UPDATER="/usr/local/bin/hh-update"
UPDATE_LOG="/var/log/homelabhero-update.log"
BROKER_LOG="/var/log/homelabhero-broker.log"
NAME_RE='^[A-Za-z0-9._-]+$'

die() { printf 'hh: %s\n' "$*" >&2; exit 1; }
ask() { local p="$1" d="${2:-}" a; if [ -n "$d" ]; then printf '%s [%s]: ' "$p" "$d" >/dev/tty; else printf '%s: ' "$p" >/dev/tty; fi; read -r a </dev/tty || true; echo "${a:-$d}"; }
asksecret() { local p="$1" a; printf '%s: ' "$p" >/dev/tty; read -rs a </dev/tty || true; printf '\n' >/dev/tty; echo "$a"; }
broker() { sudo -n -H -u "$VAULT_USER" "$BROKER" "$@"; }
conf_get() { awk -F= -v k="$2" '$1==k{sub(/^[^=]*=/,"");gsub(/^[ "]+|[ "]+$/,"");print;exit}' "$1"; }

usage() {
  cat <<'EOF'
HomelabHero

  hh list                      registered hosts (no secrets)
  hh run <alias> "<command>"   run a command on a host via the broker
  hh test <alias>              connectivity check
  hh overview                  read-only vitals sweep across all hosts
  hh inventory [alias]         what is RUNNING (VMs, LXCs, containers, apps)
                                 add --save to snapshot into inventory/
  hh scan [cidr]               discover live hosts on the network (read-only)
                                 add --add to pick and register them (operator)
  hh unifi <op> [alias] [args] read your UniFi router/console over its API.
                                 READ-ONLY: it can never change your network.
                                 ops: summary ping info sites devices device
                                      stats clients networks health get
                                 alias may be omitted with one console
  hh firewalla <op> [alias]    read your Firewalla through the MSP API.
                                 READ-ONLY: it can never change your network.
                                 ops: summary ping info boxes devices device
                                      alarms flows bandwidth rules lists
                                      trends stats get
                                 alias may be omitted with one Firewalla
  hh netbird <op> [alias]      read AND manage your NetBird mesh over its API.
                                 read:  summary ping info peers peer groups
                                        networks routers resources policies
                                        policy-show dns keys posture events
                                        traffic get
                                 BYOP:  proxies services service domains
                                 write: rename approve ssh expiration group-add
                                        group-rm policy-enable policy-disable
                                        key-create key-revoke rm-peer rm-policy
                                        rm-group
                                 destructive ops need --force
  hh cloudflare <op> [alias]   read AND manage Cloudflare DNS, tunnels, Access.
                                 read:  summary ping info account zones records
                                        tunnels tunnel-show access-apps get
                                 write: dns-set dns-proxy dns-delete
                                        tunnel-route tunnel-unroute purge
                                        access-revoke
                                 destructive ops need --force
  hh doctor                    check the whole setup is healthy
  hh diff [alias]              inventory drift vs the last saved snapshot
  hh provision <alias> <host> [port] [platform] [user]
                               register a host with a generated key (key-only,
                               no password); prints the public key to install.
                               user defaults per platform (truenas ->
                               truenas_admin, else root); or pass user@host

  hh add-host                  register a host (operator, needs sudo)
  hh add-unifi                 register a UniFi router/console with a View Only
                               API key (operator, needs sudo)
  hh add-firewalla             register a Firewalla with an MSP personal access
                               token (operator, needs sudo)
  hh add-netbird               register a NetBird mesh with a service-user token
                               (operator, needs sudo)
  hh add-cloudflare            register a Cloudflare account with a scoped API
                               token (operator, needs sudo)
  hh repin <alias>             re-pin a UniFi console's or self-hosted NetBird
                               server's TLS key after you changed its
                               certificate (operator, needs sudo)
  hh rm-host <alias>           remove a host and its credential
  hh update                    update EVERYTHING now - HomelabHero (code, skills,
                               Node), then the OS packages (operator, needs sudo;
                               also runs weekly)
  hh login                     log Claude Code in as the agent user
  hh audit [lines]             review the broker audit log (operator, needs sudo)
  hh version                   print the HomelabHero version
EOF
}

# Remote command snippets (Linux shells; kept free of dollar signs and nested
# single quotes so they survive the trip through the broker to the remote shell).
# Root hosts (the default) run everything bare. Privileged tools (zpool, qm, pct,
# docker, virsh) take a per-host prefix from _priv: empty for root, "sudo -n " for
# a non-root admin that has passwordless sudo. midclt talks to the middleware and
# never needs sudo, so it is not prefixed.
VITALS_NIX="uptime -p 2>/dev/null || uptime; free -h | grep -i '^Mem'; df -h / | tail -1"
_inv_proxmox() { local p="$1"; echo "echo '# VMs'; ${p}qm list; echo; echo '# LXCs'; ${p}pct list; echo; echo '# Storage'; ${p}pvesm status"; }
# Compact tables for the TrueNAS middleware queries, so they read like the
# Proxmox qm/pct output instead of a wall of JSON.
#
# Both formatters take the raw midclt response on stdin and stay quiet when it
# is empty, which is the normal case for a namespace this version does not have
# (midclt writes that error to stderr, which the caller discards). If a response
# arrives that is NOT a JSON array, they say so rather than printing nothing:
# a silently empty section is indistinguishable from "nothing is running", and
# that is exactly the kind of blind spot this reporting exists to remove.
#
# Guests handle two API shapes: virt.instance.query (Incus, 25.04/25.10) has
# status as a string and a type of CONTAINER or VM; vm.query (libvirt, 24.10 and
# 26) has status as {state: ...} and no type.
_TN_UNEXPECTED='[print("(unexpected response: "+raw[:60]+")") for _ in [1] if raw and raw[:1]!="["]'
_TN_GUEST_FMT='import json,sys;raw=sys.stdin.read().strip();d=json.loads(raw) if raw[:1]=="[" else [];[print("%-22s %-10s %s" % (i.get("name","?"), i.get("type","VM"), i["status"]["state"] if isinstance(i.get("status"),dict) else i.get("status","?"))) for i in d];'"${_TN_UNEXPECTED}"
_TN_APP_FMT='import json,sys;raw=sys.stdin.read().strip();d=json.loads(raw) if raw[:1]=="[" else [];[print("%-22s %-10s %s" % (i.get("name","?"), i.get("state","?"), i.get("version",""))) for i in d];'"${_TN_UNEXPECTED}"
_inv_truenas() { local p="$1"; echo "echo '# Pools'; ${p}zpool list; echo; echo '# Docker'; ${p}docker ps 2>/dev/null; echo; echo '# Apps'; midclt call app.query 2>/dev/null | python3 -c '${_TN_APP_FMT}' | head -40; echo; echo '# VMs / LXCs'; { midclt call virt.instance.query 2>/dev/null | python3 -c '${_TN_GUEST_FMT}'; midclt call vm.query 2>/dev/null | python3 -c '${_TN_GUEST_FMT}'; } | head -40"; }
_inv_linux()   { local p="$1"; echo "echo '# Containers'; command -v docker >/dev/null 2>&1 && ${p}docker ps || echo '(no docker)'; echo; echo -n '# Running services: '; systemctl list-units --type=service --state=running --no-legend --no-pager 2>/dev/null | wc -l; echo; echo '# Libvirt'; command -v virsh >/dev/null 2>&1 && ${p}virsh list --all || echo '(no libvirt)'"; }

# ---- UniFi (API-key hosts) --------------------------------------------------
#
# A UniFi console is registered like any other host but is reached over its
# local HTTPS API instead of SSH, so everything that would shell into a host has
# to route around it. These helpers are how the rest of the CLI asks "is this
# one of those?" without duplicating the answer in six places.

# Detection is keyed off PLATFORM, never off AUTH. It used to test AUTH=apikey,
# which was unambiguous while UniFi was the only credentialled API host; with
# Firewalla, NetBird and Cloudflare all authenticating by token it would now
# answer "unifi" for three things that are not.
_is_unifi() { [ -f "${REG_DIR}/$1.conf" ] && [ "$(conf_get "${REG_DIR}/$1.conf" PLATFORM)" = "unifi" ]; }
unifi_broker() { sudo -n -H -u "$VAULT_USER" "$UNIFI_BROKER" "$@"; }

_unifi_aliases() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do
  local a; a="$(basename "$f" .conf)"; _is_unifi "$a" && printf '%s\n' "$a"; done; }

# Resolve which console a command means. Nearly every homelab has exactly one
# router, so naming it every time is friction with no benefit; require the alias
# only when there is a real choice to make.
_unifi_default() {
  local list; list="$(_unifi_aliases)"
  case "$(printf '%s' "$list" | grep -c .)" in
    0) die "no UniFi console registered yet. Register one from an admin shell: hh add-unifi" ;;
    1) printf '%s' "$list" ;;
    *) die "more than one UniFi console registered; name which one: $(printf '%s' "$list" | tr '\n' ' ')" ;;
  esac
}

# ---- Firewalla (MSP token hosts) -------------------------------------------
#
# A Firewalla is read through Firewalla's MSP cloud API rather than over SSH or
# over the LAN, because Firewalla ships no supported local API. Registration is
# therefore an MSP domain and a personal access token, and everything that would
# shell into a host has to route around it, exactly as for UniFi.

_is_firewalla() { [ -f "${REG_DIR}/$1.conf" ] && [ "$(conf_get "${REG_DIR}/$1.conf" PLATFORM)" = "firewalla" ]; }
firewalla_broker() { sudo -n -H -u "$VAULT_USER" "$FW_BROKER" "$@"; }

_firewalla_aliases() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do
  local a; a="$(basename "$f" .conf)"; _is_firewalla "$a" && printf '%s\n' "$a"; done; }

_firewalla_default() {
  local list; list="$(_firewalla_aliases)"
  case "$(printf '%s' "$list" | grep -c .)" in
    0) die "no Firewalla registered yet. Register one from an admin shell: hh add-firewalla" ;;
    1) printf '%s' "$list" ;;
    *) die "more than one Firewalla registered; name which one: $(printf '%s' "$list" | tr '\n' ' ')" ;;
  esac
}

# ---- NetBird (service-user token hosts) -------------------------------------
#
# NetBird is the overlay, not a box: the "host" is the management API, and what
# it knows is the mesh - which peers exist, which are connected, what may reach
# what. Unlike UniFi and Firewalla, this broker can also CHANGE things, because
# an overlay is not the device whose failure costs you the means to fix it.

_is_netbird() { [ -f "${REG_DIR}/$1.conf" ] && [ "$(conf_get "${REG_DIR}/$1.conf" PLATFORM)" = "netbird" ]; }
netbird_broker() { sudo -n -H -u "$VAULT_USER" "$NB_BROKER" "$@"; }

_netbird_aliases() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do
  local a; a="$(basename "$f" .conf)"; _is_netbird "$a" && printf '%s\n' "$a"; done; }

_netbird_default() {
  local list; list="$(_netbird_aliases)"
  case "$(printf '%s' "$list" | grep -c .)" in
    0) die "no NetBird registered yet. Register one from an admin shell: hh add-netbird" ;;
    1) printf '%s' "$list" ;;
    *) die "more than one NetBird registered; name which one: $(printf '%s' "$list" | tr '\n' ' ')" ;;
  esac
}

# ---- Cloudflare (scoped API token hosts) ------------------------------------
#
# Cloudflare is the front door: DNS for your domain, and the tunnels that
# publish anything to the outside. Like NetBird it can write, and for the same
# reason - repointing a record is routine and reversible, in a way that
# reconfiguring the gateway is not.

_is_cloudflare() { [ -f "${REG_DIR}/$1.conf" ] && [ "$(conf_get "${REG_DIR}/$1.conf" PLATFORM)" = "cloudflare" ]; }
cloudflare_broker() { sudo -n -H -u "$VAULT_USER" "$CF_BROKER" "$@"; }

_cloudflare_aliases() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do
  local a; a="$(basename "$f" .conf)"; _is_cloudflare "$a" && printf '%s\n' "$a"; done; }

_cloudflare_default() {
  local list; list="$(_cloudflare_aliases)"
  case "$(printf '%s' "$list" | grep -c .)" in
    0) die "no Cloudflare account registered yet. Register one from an admin shell: hh add-cloudflare" ;;
    1) printf '%s' "$list" ;;
    *) die "more than one Cloudflare account registered; name which one: $(printf '%s' "$list" | tr '\n' ' ')" ;;
  esac
}

# ---- routers in general -----------------------------------------------------
#
# UniFi and Firewalla are both "a router read over an HTTP API": there is no
# shell on the far end, so `hh run`, the vitals sweep, and the inventory probes
# all have to skip them and ask their broker for a summary instead. These three
# helpers are how the rest of the CLI does that without caring which brand it is
# looking at.

_is_api_host() { case "$(_platform_of "$1")" in unifi|firewalla|netbird|cloudflare) return 0 ;; *) return 1 ;; esac; }
_api_broker_path() {
  case "$(_platform_of "$1")" in
    unifi)      printf '%s' "$UNIFI_BROKER" ;;
    firewalla)  printf '%s' "$FW_BROKER" ;;
    netbird)    printf '%s' "$NB_BROKER" ;;
    cloudflare) printf '%s' "$CF_BROKER" ;;
    *) die "'$1' is not an API host" ;;
  esac
}
# "What is running" means something different per platform: adopted gear on a
# UniFi console, known devices on a Firewalla, mesh peers on NetBird, published
# tunnels on Cloudflare. One op name per platform, so the inventory sweep does
# not have to special-case each of them where it prints.
_api_detail_op() {
  case "$(_platform_of "$1")" in
    netbird)    printf 'peers' ;;
    cloudflare) printf 'tunnels' ;;
    *)          printf 'devices' ;;
  esac
}
# Whether this platform's broker is capable of changing anything. UniFi and
# Firewalla are read-only by construction; NetBird and Cloudflare are not, and
# doctor and list should say so rather than claiming a guarantee that has
# quietly stopped applying to half the fleet.
_api_is_readonly() { case "$(_platform_of "$1")" in unifi|firewalla) return 0 ;; *) return 1 ;; esac; }
# api_broker <alias> <op> - run one read op against whichever broker owns it.
api_broker() { local a="$1"; shift; sudo -n -H -u "$VAULT_USER" "$(_api_broker_path "$a")" "$@" "$a"; }

cmd_firewalla() {
  local op="${1:-}"; shift || true
  [ -n "$op" ] || die "usage: hh firewalla <op> [alias] [args]  (ops: summary ping info boxes devices device alarms flows bandwidth rules lists trends stats get)"
  # Same shape as hh unifi: the op comes first, then an OPTIONAL alias, taken
  # only when the next argument actually names a registered Firewalla.
  local alias=""
  if [ -n "${1:-}" ] && _is_firewalla "${1}"; then alias="$1"; shift; else alias="$(_firewalla_default)"; fi
  exec sudo -n -H -u "$VAULT_USER" "$FW_BROKER" "$op" "$alias" "$@"
}

# NetBird and Cloudflare take the same op-first shape as unifi and firewalla:
# the op, then an OPTIONAL alias consumed only when the next argument actually
# names a registered host of that platform. That ordering is not cosmetic - the
# agent's permission rules match on a command PREFIX, so it is what allows
# "hh netbird peers" while still making "hh netbird rm-peer" ask.
cmd_netbird() {
  local op="${1:-}"; shift || true
  [ -n "$op" ] || die "usage: hh netbird <op> [alias] [args]
  read:  summary ping info peers peer groups networks routers resources policies
         policy-show dns keys posture events traffic get
         BYOP:  proxies services service domains
  write: rename approve ssh expiration group-add group-rm policy-enable
         policy-disable key-create key-revoke rm-peer rm-policy rm-group"
  local alias=""
  if [ -n "${1:-}" ] && _is_netbird "${1}"; then alias="$1"; shift; else alias="$(_netbird_default)"; fi
  exec sudo -n -H -u "$VAULT_USER" "$NB_BROKER" "$op" "$alias" "$@"
}

cmd_cloudflare() {
  local op="${1:-}"; shift || true
  [ -n "$op" ] || die "usage: hh cloudflare <op> [alias] [args]
  read:  summary ping info account zones records tunnels tunnel-show
         access-apps get
  write: dns-set dns-proxy dns-delete tunnel-route tunnel-unroute purge
         access-revoke"
  local alias=""
  if [ -n "${1:-}" ] && _is_cloudflare "${1}"; then alias="$1"; shift; else alias="$(_cloudflare_default)"; fi
  exec sudo -n -H -u "$VAULT_USER" "$CF_BROKER" "$op" "$alias" "$@"
}

cmd_unifi() {
  local op="${1:-}"; shift || true
  [ -n "$op" ] || die "usage: hh unifi <op> [alias] [args]  (ops: summary ping info sites devices device stats clients networks health get)"
  # The alias is optional and sits after the op. Consume it only if the next
  # argument actually names a registered console, so `hh unifi devices` and
  # `hh unifi devices gw` both do the obvious thing.
  local alias=""
  if [ -n "${1:-}" ] && _is_unifi "${1}"; then alias="$1"; shift; else alias="$(_unifi_default)"; fi
  exec sudo -n -H -u "$VAULT_USER" "$UNIFI_BROKER" "$op" "$alias" "$@"
}

# Capture a host's TLS public key so later calls can verify they are still
# talking to the same box (trust on first use, like SSH's accept-new). Prints a
# curl --pinnedpubkey value, or nothing if it cannot be read.
#
# Not UniFi-specific despite where it started: a self-hosted NetBird management
# server presents its own certificate for the same reason a console does, and
# wants the same treatment.
_tls_pin() {
  local host="$1" port="$2" pin
  pin="$(echo | openssl s_client -connect "${host}:${port}" -servername "$host" 2>/dev/null \
    | openssl x509 -pubkey -noout 2>/dev/null \
    | openssl pkey -pubin -outform der 2>/dev/null \
    | openssl dgst -sha256 -binary 2>/dev/null \
    | openssl base64 2>/dev/null)" || true
  pin="${pin//[[:space:]]/}"
  [ -n "$pin" ] && printf 'sha256//%s' "$pin"
}

# Privilege prefix for a host. Root => empty (runs bare). A non-root connect user
# => "sudo -n " but ONLY if that user has passwordless sudo, probed once per run
# and cached; otherwise empty, so we run bare and never trip the password prompt.
# midclt is never prefixed (it needs no sudo).
declare -A _PRIV_CACHE
_priv() {
  local a="$1"
  [ "$(conf_get "${REG_DIR}/$a.conf" USER)" = "root" ] && return 0
  if [ -z "${_PRIV_CACHE[$a]:-}" ]; then
    if broker "$a" 'sudo -n true' >/dev/null 2>&1; then _PRIV_CACHE[$a]='sudo -n '; else _PRIV_CACHE[$a]='none'; fi
  fi
  [ "${_PRIV_CACHE[$a]}" = 'none' ] || printf '%s' "${_PRIV_CACHE[$a]}"
  return 0
}

# ---- read-only, agent-safe --------------------------------------------------

cmd_list() {
  shopt -s nullglob
  local files=("$REG_DIR"/*.conf)
  [ "${#files[@]}" -gt 0 ] || { echo "No hosts registered yet. Run: hh add-host"; return 0; }
  printf '%-14s %-11s %-24s %-6s %-14s %-8s %s\n' ALIAS PLATFORM HOST PORT USER AUTH ACCESS
  for f in "${files[@]}"; do
    local a access; a="$(basename "$f" .conf)"
    if _is_api_host "$a"; then
      if _api_is_readonly "$a"; then access="read-only"
      elif [ "$(conf_get "$f" WRITE)" = "yes" ]; then access="READ/WRITE"
      else access="read-only"; fi
    else access="shell"; fi
    printf '%-14s %-11s %-24s %-6s %-14s %-8s %s\n' \
      "$a" "$(conf_get "$f" PLATFORM)" "$(conf_get "$f" HOST)" \
      "$(conf_get "$f" PORT)" "$(conf_get "$f" USER)" "$(conf_get "$f" AUTH)" "$access"
  done
}

cmd_run() {
  [ "$#" -ge 2 ] || die "usage: hh run <alias> \"<command>\""
  local alias="$1"; shift
  [[ "$alias" =~ $NAME_RE ]] || die "invalid alias"
  exec sudo -n -H -u "$VAULT_USER" "$BROKER" "$alias" "$@"
}

cmd_test() {
  [ "$#" -eq 1 ] || die "usage: hh test <alias>"
  if _is_api_host "$1"; then
    local out
    if out="$(api_broker "$1" ping 2>&1)"; then echo "OK: $1 reachable ($out)"
    else echo "FAIL: $1 not reachable"; printf '%s\n' "$out" | sed 's/^/  /'; return 1; fi
    return 0
  fi
  if broker "$1" 'echo homelabhero-ok' 2>/dev/null | grep -q homelabhero-ok; then
    echo "OK: $1 reachable"
  else
    echo "FAIL: $1 not reachable (check registration, key authorization, mesh)"; return 1
  fi
}

_platform_of() { conf_get "${REG_DIR}/$1.conf" PLATFORM; }

cmd_overview() {
  shopt -s nullglob
  local files=("$REG_DIR"/*.conf)
  [ "${#files[@]}" -gt 0 ] || { echo "No hosts registered. Run: hh add-host"; return 0; }
  printf 'HomelabHero overview  %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"
  for f in "${files[@]}"; do
    local a plat; a="$(basename "$f" .conf)"; plat="$(conf_get "$f" PLATFORM)"
    printf -- '---------------------------------------------\n## %s (%s)\n' "$a" "$plat"
    # A router has no shell to sweep; its vitals are what its summary op
    # reports - WAN/LAN/WiFi health on UniFi, box and device state on Firewalla.
    # Capture first, then decide: piping straight to sed would print the
    # broker's error text AND the UNREACHABLE line, which reads like two
    # different failures.
    if _is_api_host "$a"; then
      local uout
      if uout="$(api_broker "$a" summary 2>/dev/null)"; then printf '%s\n' "$uout" | sed 's/^/  /'
      else echo "  UNREACHABLE"; fi
      continue
    fi
    if ! broker "$a" 'true' 2>/dev/null; then echo "  UNREACHABLE"; continue; fi
    broker "$a" "$VITALS_NIX" 2>/dev/null | sed 's/^/  /' || true
    [ "$plat" = "truenas" ] && { echo -n "  zpool: "; broker "$a" "$(_priv "$a")zpool status -x" 2>/dev/null; }
  done
  echo '---------------------------------------------'
}

_inventory_one() {
  local a plat; a="$1"; plat="$(_platform_of "$a")"
  printf -- '=============================================\n# %s (%s)\n' "$a" "$plat"
  # "What is running" on a router means the gear it knows about - adopted APs
  # and switches on UniFi, the devices on the network for Firewalla - plus the
  # health summary above it.
  if _is_api_host "$a"; then
    local uout
    uout="$(api_broker "$a" summary 2>/dev/null)" || { echo "UNREACHABLE"; return; }
    printf '%s\n' "$uout"
    echo
    uout="$(api_broker "$a" "$(_api_detail_op "$a")" 2>/dev/null)" && printf '%s\n' "$uout"
    return
  fi
  if ! broker "$a" 'true' 2>/dev/null; then echo "UNREACHABLE"; return; fi
  local p; p="$(_priv "$a")"
  case "$plat" in
    proxmox) broker "$a" "$(_inv_proxmox "$p")" 2>/dev/null || true ;;
    truenas) broker "$a" "$(_inv_truenas "$p")" 2>/dev/null || true ;;
    *)       broker "$a" "$(_inv_linux "$p")"   2>/dev/null || true ;;
  esac
}

cmd_inventory() {
  local save=0 one=""
  for arg in "$@"; do case "$arg" in --save) save=1 ;; *) one="$arg" ;; esac; done
  shopt -s nullglob
  local aliases=()
  if [ -n "$one" ]; then aliases=("$one"); else for f in "$REG_DIR"/*.conf; do aliases+=("$(basename "$f" .conf)"); done; fi
  [ "${#aliases[@]}" -gt 0 ] || { echo "No hosts registered. Run: hh add-host"; return 0; }

  local out; out="$(printf 'HomelabHero inventory  %s\n\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')")"$'\n'
  for a in "${aliases[@]}"; do out+="$(_inventory_one "$a")"$'\n\n'; done
  printf '%s' "$out"

  if [ "$save" -eq 1 ]; then
    local dir="${HOME}/homelab-ops/inventory"
    if [ -d "$dir" ] && [ -w "$dir" ]; then
      printf '%s' "$out" > "${dir}/latest.md"
      echo "Saved snapshot to ${dir}/latest.md"
    else
      echo "(could not save: ${dir} not writable)" >&2
    fi
  fi
}

cmd_diff() {
  # Show what changed in the live inventory since the last saved snapshot. Pair
  # with `hh inventory --save` (which the box does over time), so this answers
  # "what appeared/vanished/changed since then?".
  local one="${1:-}"
  local base="${HOME}/homelab-ops/inventory/latest.md"
  [ -f "$base" ] || die "no saved snapshot at ${base} (run: hh inventory --save first)"
  local cur
  if [ -n "$one" ]; then cur="$(cmd_inventory "$one")"; else cur="$(cmd_inventory)"; fi
  # Ignore the volatile timestamp header line when comparing.
  if diff -u --label "snapshot (${base##*/})" --label "current (live)" \
       <(grep -v '^HomelabHero inventory' "$base") \
       <(printf '%s\n' "$cur" | grep -v '^HomelabHero inventory'); then
    echo "No drift since the last saved snapshot."
  fi
}

_registered_ips() { shopt -s nullglob; for f in "$REG_DIR"/*.conf; do conf_get "$f" HOST; done; }

# The address this box actually routes through. More reliable than guessing,
# and it is what makes "found your router" a statement rather than a hunch.
#
# Never fails: not knowing the default route is a normal state (an isolated LXC
# may have none) and only costs us one of two gateway hints, so it must not be
# able to abort a scan. The explicit `|| true` matters because pipefail would
# otherwise surface a missing `ip` as a fatal pipeline failure.
_default_gw() {
  ip route show default 2>/dev/null \
    | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}' || true
}

# Is this IP the router? Either it is literally our default route, or it sits at
# the .1 of its subnet, which is where a home gateway lives often enough to be
# worth probing even when this box routes somewhere else (a scan of a subnet we
# are not on, a double-NAT lab, a VLAN with its own gateway).
_looks_like_gateway() {
  local ip="$1" gw="$2"
  [ -n "$gw" ] && [ "$ip" = "$gw" ] && return 0
  case "$ip" in *.1) return 0 ;; esac
  return 1
}

# Fingerprint a UniFi console without credentials. Echoes "<how> <version>" on a
# match. Ordered most to least certain: the Network application answers an
# unauthenticated status probe with its version, which is proof; the TLS
# certificate is only a strong hint, so it is the last resort rather than the
# first check.
_unifi_probe() {
  local ip="$1" body ver
  local url
  for url in "https://${ip}/proxy/network/status" "https://${ip}/status" "https://${ip}:8443/status"; do
    body="$(curl -sk -m 3 "$url" 2>/dev/null || true)"
    case "$body" in
      *server_version*)
        ver="$(printf '%s' "$body" | jq -r '.meta.server_version // empty' 2>/dev/null || true)"
        case "$url" in
          *:8443/status) printf 'controller %s' "${ver:-?}" ;;
          *)             printf 'console %s' "${ver:-?}" ;;
        esac
        return 0 ;;
    esac
  done
  body="$(echo | openssl s_client -connect "${ip}:443" -servername "$ip" 2>/dev/null \
    | openssl x509 -noout -subject -issuer 2>/dev/null || true)"
  case "$body" in
    *UniFi*|*Ubiquiti*|*unifi*|*ubnt*) printf 'certificate ?'; return 0 ;;
  esac
  return 1
}

cmd_scan() {
  local add=0 cidr=""
  for arg in "$@"; do case "$arg" in --add) add=1 ;; *) cidr="$arg" ;; esac; done
  [ -n "$cidr" ] || cidr="$(ip -o -f inet addr show scope global 2>/dev/null | awk '{print $4; exit}')"
  [ -n "$cidr" ] || die "could not detect a subnet; pass one, e.g. hh scan 10.0.0.0/24"
  echo "Scanning ${cidr} for management endpoints..." >&2

  # 8443 is the legacy self-hosted UniFi Network application; a UniFi OS console
  # (UDM, UCG, Cloud Key) answers on 443 like everything else.
  local ports="22,80,443,445,8006,8443"
  declare -a IPS PORTLIST
  if command -v nmap >/dev/null 2>&1; then
    while read -r ip openports; do
      IPS+=("$ip"); PORTLIST+=("$openports")
    done < <(nmap -Pn -T4 --open -p "$ports" -oG - "$cidr" 2>/dev/null \
      | awk -F'\t' '/Ports:/{ip=$1; sub(/Host: /,"",ip); sub(/ .*/,"",ip);
          p=$2; gsub(/Ports: /,"",p); gsub(/\/open[^,]*/,"",p); gsub(/,/,"",p); gsub(/ +/,",",p); sub(/^,/,"",p); print ip" "p}')
  else
    echo "(nmap not installed; slower basic scan. For better results: sudo apt install nmap)" >&2
    local base="${cidr%/*}"; base="${base%.*}"
    for n in $(seq 1 254); do
      local ip="${base}.${n}" open=""
      for p in 22 8006 443 445 80 8443; do
        timeout 1 bash -c "exec 3<>/dev/tcp/${ip}/${p}" 2>/dev/null && open="${open}${p} "
      done
      [ -n "$open" ] && { IPS+=("$ip"); PORTLIST+=("${open% }"); }
    done
  fi

  local regips gw; regips="$(_registered_ips | tr '\n' ' ')"; gw="$(_default_gw)"
  # Remember, per row, which entries are a confirmed UniFi console, so the
  # picker below can offer the API-key path instead of asking for SSH details
  # that a router does not have.
  declare -a UNIFI
  printf '\n%-4s %-16s %-20s %-16s %-9s %s\n' '#' 'IP' 'OPEN PORTS' 'GUESS' 'ROLE' 'REGISTERED?'
  local i=0 found_unifi=""
  for idx in "${!IPS[@]}"; do
    i=$((i+1))
    local ip="${IPS[$idx]}" op="${PORTLIST[$idx]}" guess reg="new" role="" uni=""
    case " ${op//,/ } " in
      *" 8006 "*) guess="proxmox" ;;
      *" 443 "*)  guess="truenas?/linux" ;;
      *" 22 "*)   guess="linux" ;;
      *)          guess="?" ;;
    esac
    # Probe for UniFi only where it could plausibly be one, so a full subnet
    # sweep does not pay for a handful of HTTPS round trips per host.
    local maybe_unifi=1
    _looks_like_gateway "$ip" "$gw" && { role="gateway"; maybe_unifi=0; }
    case " ${op//,/ } " in *" 8443 "*) maybe_unifi=0 ;; esac
    if [ "$maybe_unifi" -eq 0 ] && uni="$(_unifi_probe "$ip")"; then
      guess="unifi"; UNIFI[$idx]="$uni"
      [ -n "$found_unifi" ] || found_unifi="$i"
    fi
    case " $regips " in *" $ip "*) reg="registered" ;; esac
    printf '%-4s %-16s %-20s %-16s %-9s %s\n' "$i" "$ip" "${op// /,}" "$guess" "${role:--}" "$reg"
  done
  [ "$i" -gt 0 ] || { echo "No endpoints found."; return 0; }

  # Call the router out by name. It is the one device on this list a person may
  # not think of as "a server to add", and it is the one that explains the most
  # about why everything else is or is not working.
  if [ -n "$found_unifi" ]; then
    local uidx=$((found_unifi-1)) ukind uver udesc
    ukind="${UNIFI[$uidx]%% *}"; uver="${UNIFI[$uidx]#* }"
    case "$ukind" in
      console)     udesc="UniFi OS console running Network ${uver}" ;;
      controller)  udesc="self-hosted UniFi Network application ${uver} on port 8443" ;;
      *)           udesc="UniFi device (identified by its TLS certificate)" ;;
    esac
    cat <<EOF

Found your router: a ${udesc} at ${IPS[$uidx]}  (number ${found_unifi} above).
Adding it lets Claude see WAN and internet health, every adopted access point
and switch, connected clients, and pending firmware, so "the internet is down"
and "wifi is slow" become answerable instead of guesswork.

It connects with a UniFi API key, not SSH, and HomelabHero only ever READS from
it. It cannot change your network, by design.
EOF
  fi

  if [ "$add" -eq 1 ]; then
    # Registering hosts writes the registry and generates keys: an operator
    # action. Refuse cleanly for the low-privilege agent rather than failing
    # partway through the loop when the first sudo call is rejected.
    [ "$(id -u)" -eq 0 ] || sudo -v 2>/dev/null || \
      die "hh scan --add registers hosts and needs sudo; run it from an admin shell, not the Claude UI"
    echo
    local pick; pick="$(ask 'Numbers to register (comma-separated, blank to skip)')"
    IFS=',' read -ra nums <<<"$pick"
    for n in "${nums[@]}"; do
      n="${n// /}"; [[ "$n" =~ ^[0-9]+$ ]] || continue
      local idx=$((n-1)); [ -n "${IPS[$idx]:-}" ] || continue
      local ip="${IPS[$idx]}" op="${PORTLIST[$idx]}" plat=linux
      # A confirmed UniFi console is not an SSH host at all, so it skips the
      # platform question entirely rather than offering choices that do not
      # apply to it.
      if [ -n "${UNIFI[$idx]:-}" ]; then
        echo; echo "Registering ${ip} as your UniFi router ..."
        cmd_add_host --host "$ip" --port 443 --platform unifi
        continue
      fi
      # Guess from open ports, then let the operator confirm or correct it
      # (443 alone is often TrueNAS, but just as often a plain Linux web host).
      case " ${op//,/ } " in
        *" 8006 "*) plat=proxmox ;;
        *" 443 "*)  plat=truenas ;;
      esac
      # Firewalla is deliberately not on this list. It is read through its MSP
      # domain, which is not an address on this network, so there is nothing a
      # scan could register - see the hint printed after the loop.
      plat="$(ask "Platform for ${ip} (linux/truenas/proxmox/unifi)" "$plat")"
      echo; echo "Registering ${ip} as ${plat} ..."
      case "$plat" in
        unifi)     cmd_add_host --host "$ip" --port 443 --platform unifi ;;
        firewalla) echo "A Firewalla is not registered by address: HomelabHero reads it through"
                   echo "Firewalla MSP. Register it with 'hh add-firewalla' instead. Skipping ${ip}." ;;
        netbird|cloudflare)
                   echo "${plat} is not registered by address - it is an account and an API, not a"
                   echo "box on this subnet. Register it with 'hh add-${plat}' instead. Skipping ${ip}." ;;
        *)         cmd_add_host --host "$ip" --port 22 --platform "$plat" ;;
      esac
    done
    echo
    echo "Router note: a Firewalla does not appear here as something to register."
    echo "It has no local API to read, so it is added through Firewalla MSP with:"
    echo "    hh add-firewalla"
    echo "    hh add-netbird"
    echo "    hh add-cloudflare"
  else
    echo; echo "To register: hh scan ${cidr} --add   (or: hh add-host)"
  fi
}

cmd_doctor() {
  local fail=0 warn=0
  ok()   { printf '  [ok]   %s\n' "$*"; }
  bad()  { printf '  [FAIL] %s\n' "$*"; fail=$((fail+1)); }
  note() { printf '  [warn] %s\n' "$*"; warn=$((warn+1)); }

  echo "HomelabHero doctor"
  echo "Setup"
  id "$AGENT_USER" >/dev/null 2>&1 && ok "agent user ${AGENT_USER} exists" || bad "missing user ${AGENT_USER}"
  id "$VAULT_USER" >/dev/null 2>&1 && ok "vault user ${VAULT_USER} exists" || bad "missing user ${VAULT_USER}"
  [ -x "$BROKER" ] && ok "broker installed" || bad "broker missing at ${BROKER}"
  [ -x "$UNIFI_BROKER" ] && ok "unifi broker installed (read-only)" || note "unifi broker missing at ${UNIFI_BROKER} (run: hh update)"
  [ -x "$FW_BROKER" ] && ok "firewalla broker installed (read-only)" || note "firewalla broker missing at ${FW_BROKER} (run: hh update)"
  [ -x "$NB_BROKER" ] && ok "netbird broker installed (read/write)" || note "netbird broker missing at ${NB_BROKER} (run: hh update)"
  [ -x "$CF_BROKER" ] && ok "cloudflare broker installed (read/write)" || note "cloudflare broker missing at ${CF_BROKER} (run: hh update)"
  if [ -d "$VAULT_DIR" ]; then
    local perm; perm="$(stat -c '%a %U' "$VAULT_DIR" 2>/dev/null || true)"
    [ "$perm" = "700 ${VAULT_USER}" ] && ok "vault perms (${perm})" || note "vault perms are '${perm}', expected '700 ${VAULT_USER}'"
  else bad "vault dir missing"; fi
  if [ -f "$BROKER_LOG" ]; then
    local bperm; bperm="$(stat -c '%a %U' "$BROKER_LOG" 2>/dev/null || true)"
    [ "$bperm" = "600 ${VAULT_USER}" ] && ok "broker audit log protected (${bperm})" || note "broker audit log perms are '${bperm}', expected '600 ${VAULT_USER}'"
  else note "broker audit log not present yet (${BROKER_LOG})"; fi

  echo "Runtime"
  if systemctl is-active --quiet homelab-cc; then ok "service homelab-cc active"; else bad "service homelab-cc not active"; fi
  local ahome cv
  ahome="$(getent passwd "$AGENT_USER" | cut -d: -f6)"
  # Resolve claude the way the service does: ~/.local/bin (Anthropic's native
  # installer) FIRST, then the nvm prefix (the npm package). Report the path
  # next to the version - "which claude is this box actually running" is the
  # first question to answer when the two disagree.
  cv="$(sudo -n -u "$AGENT_USER" -H bash -c "export NVM_DIR=\"${ahome}/.nvm\"; [ -s \"\$NVM_DIR/nvm.sh\" ] && . \"\$NVM_DIR/nvm.sh\" >/dev/null 2>&1; export PATH=\"${ahome}/.local/bin:\$PATH\"; command -v claude >/dev/null && printf '%s\t%s' \"\$(claude --version 2>/dev/null | head -1)\" \"\$(command -v claude)\"" 2>/dev/null | tail -1 || true)"
  if [ -n "$cv" ]; then ok "claude: $(printf '%s' "$cv" | awk -F'\t' '{print $1" at "$2}')"
  else note "could not read claude version here (fine if not run with sudo)"; fi

  # The ops brain is half shipped and half yours, and an update preserves your
  # half rather than overwriting it. That is only trustworthy if you can see
  # what it decided, so say it here instead of leaving it to a git diff.
  echo "Ops brain"
  local opsdir="${ahome}/homelab-ops" edited=0 pending=0 sf rel
  if [ -d "$SHIPPED_DIR" ] && [ -r "$opsdir" ]; then
    while IFS= read -r sf; do
      rel="${sf#"${SHIPPED_DIR}/"}"
      [ -e "${opsdir}/${rel}" ] || continue
      cmp -s "$sf" "${opsdir}/${rel}" || edited=$((edited+1))
      [ -e "${opsdir}/${rel}.upstream" ] && pending=$((pending+1))
    done < <(find "$SHIPPED_DIR" -type f 2>/dev/null)
    if [ "$edited" -gt 0 ]; then
      ok "${edited} shipped file(s) edited locally; updates keep your version"
    else
      ok "shipped files match what was last delivered"
    fi
    if [ "$pending" -gt 0 ]; then
      note "${pending} newer shipped version(s) waiting as *.upstream in ${opsdir}"
      printf '           merge what you want from them, then delete them:\n'
      printf '           find %s -name "*.upstream"\n' "$opsdir"
    fi
    [ -e "${opsdir}/CLAUDE.local.md" ] || note "no CLAUDE.local.md yet (run: hh update) - it is the place for local notes that never need merging"
  elif [ ! -d "$SHIPPED_DIR" ]; then
    note "no pristine copy at ${SHIPPED_DIR} yet; run 'hh update' once and local edits are preserved from then on"
  else
    note "cannot read ${opsdir} from here (fine if not run with sudo)"
  fi

  echo "Hosts"
  shopt -s nullglob
  local files=("$REG_DIR"/*.conf)
  [ "${#files[@]}" -eq 0 ] && note "no hosts registered yet (hh add-host)"
  for f in "${files[@]}"; do
    local a u; a="$(basename "$f" .conf)"; u="$(conf_get "$f" USER)"
    if _is_api_host "$a"; then
      local kind; kind="$(conf_get "$f" PLATFORM)"
      if api_broker "$a" ping >/dev/null 2>&1; then
        # Do not claim "read-only" for a platform where it is no longer true.
        # UniFi and Firewalla cannot write at all; NetBird and Cloudflare can,
        # and whether THIS alias may depends on the credential it holds.
        if _api_is_readonly "$a"; then
          ok "reach ${a} (${kind} API, read-only)"
        elif [ "$(conf_get "$f" WRITE)" = "yes" ]; then
          ok "reach ${a} (${kind} API, read/write - destructive ops need --force)"
        else
          ok "reach ${a} (${kind} API, read-only token)"
        fi
        # Only a UniFi console is TLS-pinned, because only it presents a
        # self-signed certificate. A Firewalla is reached at its MSP domain,
        # which has a publicly trusted one, so ordinary CA verification already
        # covers it and there is no pin to miss.
        if _is_unifi "$a" && [ -z "$(conf_get "$f" PIN)" ]; then
          note "${a} has no TLS pin; re-pin it with: hh repin ${a}"
        fi
      else
        bad "cannot reach ${a} over the ${kind} API (credential rejected, device offline, or cert changed)"
        printf '           detail: %s\n' "$(api_broker "$a" ping 2>&1 | head -1)"
      fi
      continue
    fi
    if ! broker "$a" 'echo ok' 2>/dev/null | grep -q ok; then bad "cannot reach ${a}"; continue; fi
    if [ "$u" = "root" ] || broker "$a" 'sudo -n true' >/dev/null 2>&1; then ok "reach ${a} (${u})"
    else
      note "reach ${a} (${u}) - no passwordless sudo: raw root tools (docker, zpool, smartctl) will not run (midclt still works)."
      printf '           fix: TrueNAS UI -> Credentials -> Users -> %s -> Edit -> "Allow all sudo commands with no password"; or re-register %s as root.\n' "$u" "$a"
    fi
  done

  echo "Auto-update"
  if [ -f "$UPDATE_LOG" ]; then ok "last update log: $(tail -1 "$UPDATE_LOG" 2>/dev/null | cut -c1-70)"
  else note "no update has run yet (${UPDATE_LOG} not present)"; fi

  echo
  if [ "$fail" -gt 0 ]; then echo "RESULT: ${fail} problem(s), ${warn} warning(s)."; return 1
  else echo "RESULT: healthy (${warn} warning(s))."; fi
}

# ---- operator ---------------------------------------------------------------

cmd_add_host() {
  local alias="" host="" port="" plat="" ruser="" auth="" cred=""
  while [ "$#" -gt 0 ]; do case "$1" in
    --alias) alias="$2"; shift 2 ;;
    --host) host="$2"; shift 2 ;;
    --port) port="$2"; shift 2 ;;
    --platform) plat="$2"; shift 2 ;;
    *) shift ;;
  esac; done

  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-host needs sudo (run from an admin shell, not the Claude UI)"
  # Platform is settled before the alias so a UniFi console can suggest a
  # sensible name and then skip every SSH question, which does not apply to it.
  [ -n "$plat" ] || plat="$(ask 'Platform (linux/truenas/proxmox/unifi/firewalla/netbird/cloudflare)' linux)"
  case "$plat" in linux|truenas|proxmox|unifi|firewalla|netbird|cloudflare) : ;; *) die "unknown platform: ${plat} (linux, truenas, proxmox, unifi, firewalla, netbird, cloudflare)" ;; esac
  if [ -z "$alias" ]; then
    case "$plat" in
      unifi|firewalla) alias="$(ask 'Alias (short name for your router)' router)" ;;
      netbird)         alias="$(ask 'Alias (short name for your mesh)' mesh)" ;;
      cloudflare)      alias="$(ask 'Alias (short name for your Cloudflare account)' cloudflare)" ;;
      *)               alias="$(ask 'Alias (short name, e.g. pve1)')" ;;
    esac
  fi
  [[ "$alias" =~ $NAME_RE ]] || die "invalid alias"
  [ -f "${REG_DIR}/${alias}.conf" ] && die "alias already registered"
  # A Firewalla is reached at an MSP domain, never at an address on the LAN, so
  # ask for the thing it will actually use instead of an IP it cannot use.
  if [ "$plat" = "firewalla" ]; then
    [ -n "$host" ] || host="$(ask 'Your Firewalla MSP domain (e.g. yourname.firewalla.net)')"
    _add_firewalla_host "$alias" "$host" "${port:-443}"; return
  fi
  # Cloudflare is always the same endpoint - there is nothing to ask, and asking
  # would only invite an answer that cannot work.
  if [ "$plat" = "cloudflare" ]; then
    _add_cloudflare_host "$alias" "api.cloudflare.com" "${port:-443}"; return
  fi
  if [ "$plat" = "netbird" ]; then
    [ -n "$host" ] || host="$(ask 'NetBird management host (leave as-is for NetBird Cloud)' api.netbird.io)"
    _add_netbird_host "$alias" "$host" "${port:-443}"; return
  fi
  [ -n "$host" ] || host="$(ask 'IP or hostname')"
  if [ "$plat" = "unifi" ]; then _add_unifi_host "$alias" "$host" "${port:-443}"; return; fi
  [ -n "$port" ] || port="$(ask 'SSH port' 22)"
  ruser="$(ask 'Username' root)"
  auth="$(ask 'Auth method (key recommended / password)' key)"

  case "$auth" in
    key)
      cred="${alias}.key"
      echo "Generating a dedicated key in the vault..." >/dev/tty
      sudo -u "$VAULT_USER" ssh-keygen -t ed25519 -N '' -q -f "${VAULT_DIR}/${cred}" -C "homelabhero-${alias}"
      echo >/dev/tty; echo "Public key to authorize on ${host}:" >/dev/tty
      sudo cat "${VAULT_DIR}/${cred}.pub" >/dev/tty; echo >/dev/tty
      if [ "$(ask 'Install it now via ssh-copy-id? (needs the remote password once) (y/N)' N)" = "y" ]; then
        sudo -u "$VAULT_USER" ssh-copy-id -i "${VAULT_DIR}/${cred}.pub" -p "$port" "${ruser}@${host}" </dev/tty || \
          echo "ssh-copy-id did not complete; authorize the key manually." >/dev/tty
      fi
      ;;
    password)
      echo "WARNING: password auth is weaker and harder to isolate. Prefer keys." >/dev/tty
      cred="${alias}.pw"
      local pw; pw="$(asksecret "Password for ${ruser}@${host}")"
      printf '%s' "$pw" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
      sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"; unset pw
      ;;
    *) die "unknown auth method" ;;
  esac

  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=${plat}
HOST=${host}
PORT=${port}
USER=${ruser}
AUTH=${auth}
CRED=${cred}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"
  echo "Registered '${alias}'. Testing..." >/dev/tty
  cmd_test "$alias" || true
}

# Register a UniFi console. Operator-only and shell-only, for the same reason
# password auth is: an API key is a secret being typed, and a secret typed into
# an LLM session has already been seen by the LLM. There is deliberately no
# UI/agent path to this (nothing in hh-provision registers one).
_add_unifi_host() {
  local alias="$1" host="$2" port="$3" cred="${1}.apikey" key pin
  cat >/dev/tty <<EOF

Registering ${host} as a UniFi router.

HomelabHero reads your UniFi console over its local API, which needs an API key.
Create one in the UniFi Network app:

  1. Settings -> Control Plane -> Integrations -> Create API Key
     (older versions put it under Settings -> Admins, or Control Plane ->
     Admins; the wording moved between Network 8, 9, and 10.)
  2. Give it a name like "homelabhero" and copy the key. UniFi shows it once.

  IMPORTANT: create the key under an admin whose role is VIEW ONLY.

  The key inherits that admin's permissions, so a View Only admin produces a key
  that physically cannot change your network - the console itself refuses the
  write. HomelabHero never issues anything but reads either, so this is a second
  lock on the same door. If you mint the key under a full admin instead, this
  tool still will not write, but the key in the vault would be able to.

  Requires a UniFi OS console (UDM, UCG, Cloud Key Gen2+, UniFi OS Server) on
  Network 9.0 or newer. API keys do not exist on the old self-hosted app.

EOF
  key="$(asksecret "UniFi API key for ${host}")"
  [ -n "$key" ] || die "no key entered"
  printf '%s' "$key" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
  sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"
  unset key

  # Pin the console's TLS public key now, while we are talking to it for the
  # first time and can reasonably assume the LAN is honest. Every later call
  # verifies against this, which is what stops the key being handed to an
  # impostor on the network later.
  echo "Pinning the console's TLS key..." >/dev/tty
  pin="$(_tls_pin "$host" "$port" || true)"
  [ -n "$pin" ] || echo "  (could not read the certificate; continuing unpinned)" >/dev/tty

  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=unifi
HOST=${host}
PORT=${port}
USER=api-key
AUTH=apikey
CRED=${cred}
PIN=${pin}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"

  echo >/dev/tty; echo "Registered '${alias}'. Testing..." >/dev/tty
  if cmd_test "$alias"; then
    # Resolve and cache the site id so the first real command is not slower
    # than every one after it.
    unifi_broker sites "$alias" >/dev/null 2>&1 || true
    echo >/dev/tty
    unifi_broker summary "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
  else
    cat >/dev/tty <<EOF

The key did not work. Nothing is broken; the registration is saved but unusable.
Check that you copied the whole key and that the console is on Network 9.0+,
then replace it:

    hh rm-host ${alias}
    hh add-unifi
EOF
  fi
}

# Register a Firewalla. Operator-only and shell-only, for the same reason the
# UniFi path is: the token is a secret being typed, and a secret typed into an
# LLM session has already been seen by the LLM. There is deliberately no
# UI/agent path to this.
_add_firewalla_host() {
  local alias="$1" host="$2" port="$3" cred="${1}.token" token
  # People paste a URL out of the browser bar. Take the domain out of it rather
  # than storing something that will never resolve.
  host="${host#https://}"; host="${host#http://}"; host="${host%%/*}"
  # An IP here is the single most likely mistake, because every other host in
  # HomelabHero is registered by address. Name the misunderstanding instead of
  # registering something that cannot work.
  case "$host" in
    *[!0-9.]*) : ;;
    *) die "'${host}' is an IP address. Firewalla has no local API for HomelabHero
    to read, so it is reached through your MSP domain instead - something like
    yourname.firewalla.net. Register that." ;;
  esac
  cat >/dev/tty <<EOF

Registering ${host} as your Firewalla.

Firewalla has no local API on the box, so HomelabHero reads it through
Firewalla MSP - Firewalla's own management portal - using a personal access
token:

  1. Sign in to your MSP at https://${host}
  2. Account Settings -> Create New Token, name it "homelabhero", and copy it.

  READ THIS PART. Unlike UniFi, Firewalla MSP has no read-only token: a token
  carries the permissions of the account that made it, and there is no view-only
  role to mint it under. So the one thing keeping this token from changing your
  network is HomelabHero itself - the broker behind 'hh firewalla' can only ever
  issue an HTTP GET, and has no code path that could POST, PUT, PATCH or DELETE.

  The token is stored in the vault, readable only by the ${VAULT_USER} user, and
  is never shown to Claude. If you would rather not hold one at all, that is a
  reasonable choice: skip this and keep reading your Firewalla in its own app.

  A token sees every box on your MSP account, but an alias means exactly ONE
  box, so if there is more than one you will be asked which. Run this again with
  the same token to register another.

EOF
  token="$(asksecret "Firewalla MSP personal access token for ${host}")"
  [ -n "$token" ] || die "no token entered"
  printf '%s' "$token" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
  sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"
  unset token

  # No TLS pin here, unlike UniFi. Pinning exists to make a self-signed LAN
  # certificate trustworthy; an MSP domain is a public host with a publicly
  # trusted certificate, and ordinary CA verification is the stronger check.
  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=firewalla
HOST=${host}
PORT=${port}
USER=api-token
AUTH=token
CRED=${cred}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"

  echo >/dev/tty; echo "Registered '${alias}'. Testing..." >/dev/tty
  if cmd_test "$alias"; then
    _pin_firewalla_box "$alias"
    echo >/dev/tty
    firewalla_broker summary "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
  else
    cat >/dev/tty <<EOF

The token did not work. Nothing is broken; the registration is saved but
unusable. Check that you copied the whole token and that the domain is your MSP
domain (yourname.firewalla.net), not the box's LAN address, then replace it:

    hh rm-host ${alias}
    hh add-firewalla
EOF
  fi
}

# Register a NetBird mesh. Operator-only and shell-only, for the same reason the
# UniFi and Firewalla paths are: the token is a secret being typed, and a secret
# typed into an LLM session has already been seen by the LLM.
_add_netbird_host() {
  local alias="$1" host="$2" port="$3" cred="${1}.token" token pin write
  # People paste a URL out of the browser bar. Take the host out of it rather
  # than storing something that will never resolve.
  host="${host#https://}"; host="${host#http://}"; host="${host%%/*}"
  cat >/dev/tty <<EOF

Registering ${host} as your NetBird mesh.

HomelabHero reads the mesh from NetBird's management API rather than from any
one peer, which is what lets it still answer when a peer is down. That needs a
token, and NetBird's own answer for this is a SERVICE USER - a non-interactive
account made for exactly this purpose:

  1. Sign in to NetBird (https://app.netbird.io for Cloud).
  2. Team -> Service Users -> create one, named something like "homelabhero".
  3. Pick its role. This is the important choice:

       User   - READ-ONLY. Everything HomelabHero reports still works.
       Admin  - can also change the mesh: approve peers, move them between
                groups, enable and disable policies, remove peers.

  4. Open that service user and create a token. Copy it - NetBird stores only a
     hash, so this is the one time you can see it.

  Pick User unless you actually want Claude able to change the mesh. If you pick
  Admin, know what that buys and what it costs: the write ops become available,
  and every read then runs with a credential that could have written. The broker
  is what keeps that in check - it has no generic write path, only named ops, and
  anything destructive refuses without --force - but with an Admin token that
  fencing is the only lock, not the second one.

  The token is stored in the vault, readable only by the ${VAULT_USER} user, and
  is never shown to Claude.

EOF
  token="$(asksecret "NetBird token for ${host}")"
  [ -n "$token" ] || die "no token entered"
  printf '%s' "$token" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
  sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"
  unset token

  # Record what the token can do rather than discovering it from a 403 later.
  # NetBird has no endpoint that reliably reports a service user's own role to
  # itself, so this is asked rather than probed - and asked in terms of the
  # choice just made, not in terms of an API concept.
  if [ "$(ask 'Did you give that service user the Admin role (so HomelabHero may change the mesh)? (y/N)' N)" = "y" ]; then
    write="yes"
  else
    write="no"
  fi

  # NetBird Cloud has a publicly trusted certificate and needs no pin. A
  # self-hosted server usually presents its own, so try ordinary verification
  # first and pin ONLY if that is what is standing in the way - a pin recorded
  # when CA verification would have worked is a maintenance burden with no gain.
  # Probe with ordinary CA verification and read the EXIT STATUS, not the HTTP
  # status: an unauthenticated 401 means the certificate was fine and only the
  # credential was missing, which is exactly what we want to see. curl's 35/51/60
  # are the TLS failures, and they are the only reason to reach for a pin.
  pin=""
  if [ "$host" != "api.netbird.io" ]; then
    local rc=0
    curl -sS -m 10 -o /dev/null "https://${host}:${port}/api/peers" >/dev/null 2>&1 || rc=$?
    case "$rc" in
      35|51|60)
        echo "This server's certificate is not publicly trusted; pinning its key instead..." >/dev/tty
        pin="$(_tls_pin "$host" "$port" || true)"
        [ -n "$pin" ] || echo "  (could not read the certificate; continuing unpinned)" >/dev/tty ;;
    esac
  fi

  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=netbird
HOST=${host}
PORT=${port}
USER=service-user
AUTH=token
CRED=${cred}
WRITE=${write}
PIN=${pin}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"

  echo >/dev/tty
  if [ "$write" = "yes" ]; then
    echo "Registered '${alias}'. This token can CHANGE the mesh; destructive ops still need --force." >/dev/tty
  else
    echo "Registered '${alias}'. This token is read-only." >/dev/tty
  fi
  echo "Testing..." >/dev/tty
  if cmd_test "$alias"; then
    echo >/dev/tty
    netbird_broker summary "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
  else
    cat >/dev/tty <<EOF

The token did not work. Nothing is broken; the registration is saved but
unusable. NetBird tokens are created with an expiry, so check it has not lapsed,
and that you copied the whole thing, then replace it:

    hh rm-host ${alias}
    hh add-netbird
EOF
  fi
}

# Register a Cloudflare account. Operator-only and shell-only, same reasoning.
_add_cloudflare_host() {
  local alias="$1" host="$2" port="$3" cred="${1}.token" token write
  cat >/dev/tty <<EOF

Registering your Cloudflare account.

HomelabHero reads Cloudflare's own view of your DNS and tunnels, which is the
view that stays answerable when the host running cloudflared is not. That needs
a CUSTOM API TOKEN - never the Global API Key, which cannot be scoped and would
put full account control in the vault.

  Create it at: My Profile -> API Tokens -> Create Token -> Custom token

  For READ-ONLY (everything HomelabHero reports still works):
      Account | Cloudflare Tunnel          | Read
      Account | Access: Apps and Policies  | Read
      Account | Account Settings           | Read      <- see note
      Zone    | Zone                       | Read
      Zone    | DNS                        | Read

  Account Settings: Read is what lets the token LIST your accounts, which is how
  the tunnel and Access ops know which account to address. Without it Cloudflare
  answers that request with an empty list rather than an error. HomelabHero works
  around it by reading the account off one of your zones, so a token without it
  is fine as long as the token can also see at least one zone - but granting it
  is the tidier answer, and it grants nothing else.

  To also let HomelabHero CHANGE things, use Edit instead of Read for
  Cloudflare Tunnel and DNS. Leave Account Settings on Read - nothing here
  writes account settings. That enables: dns-set, dns-proxy, dns-delete,
  tunnel-route, tunnel-unroute, purge and access-revoke.

  Under "Zone Resources", prefer "Include -> Specific zone" and name only the
  domains your homelab uses. A token scoped to one zone cannot touch another
  even if something ever reached it outside this broker.

  Grant Read unless you actually want Claude able to change your DNS. DNS is
  cached far and wide, so a wrong change outlives the moment it was made.

  The token is stored in the vault, readable only by the ${VAULT_USER} user, and
  is never shown to Claude.

EOF
  token="$(asksecret "Cloudflare API token")"
  [ -n "$token" ] || die "no token entered"
  printf '%s' "$token" | sudo -u "$VAULT_USER" tee "${VAULT_DIR}/${cred}" >/dev/null
  sudo -u "$VAULT_USER" chmod 600 "${VAULT_DIR}/${cred}"
  unset token

  if [ "$(ask 'Did you grant Edit permissions (so HomelabHero may change DNS and tunnels)? (y/N)' N)" = "y" ]; then
    write="yes"
  else
    write="no"
  fi

  # No TLS pin: api.cloudflare.com is a public host with a publicly trusted
  # certificate, and ordinary CA verification is the stronger check.
  sudo tee "${REG_DIR}/${alias}.conf" >/dev/null <<EOF
# HomelabHero host registry entry (non-secret)
PLATFORM=cloudflare
HOST=${host}
PORT=${port}
USER=api-token
AUTH=token
CRED=${cred}
WRITE=${write}
EOF
  sudo chmod 644 "${REG_DIR}/${alias}.conf"

  echo >/dev/tty; echo "Registered '${alias}'. Testing..." >/dev/tty
  if cmd_test "$alias"; then
    # Resolve and cache the account id so the first real command is not slower
    # than every one after it.
    # Resolve and cache the account id now, so the first tunnel or Access
    # command is not slower than every one after it - and so a token that cannot
    # resolve one says so here, while the operator is still at the keyboard,
    # rather than on some later call.
    cloudflare_broker account "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
    echo >/dev/tty
    cloudflare_broker summary "$alias" 2>&1 | sed 's/^/  /' >/dev/tty || true
  else
    cat >/dev/tty <<EOF

The token did not work. Nothing is broken; the registration is saved but
unusable. Check that you copied the whole token and that it has at least the
Read permissions listed above, then replace it:

    hh rm-host ${alias}
    hh add-cloudflare
EOF
  fi
}

# Pin the alias to ONE box.
#
# An MSP token is scoped to an account, not to a box, so without this an alias
# on a two-box account reads both at once and says nothing about which row came
# from where. One box is the overwhelmingly common case and needs no question
# asked; more than one is a real choice and only the operator can make it.
#
# Failing here is not fatal: the registration still works, and the broker
# resolves a single-box account by itself on first use. It only refuses to guess
# when the account genuinely has several.
_pin_firewalla_box() {
  local alias="$1" boxes n gid bname pick
  echo >/dev/tty; echo "Checking which Firewalla boxes this token can see..." >/dev/tty
  if ! boxes="$(firewalla_broker info "$alias" 2>/dev/null)" \
     || ! printf '%s' "$boxes" | jq -e 'type == "array"' >/dev/null 2>&1; then
    echo "  (could not read the box list; the broker will resolve it on first use)" >/dev/tty
    return 0
  fi
  n="$(printf '%s' "$boxes" | jq -r 'length')"
  case "$n" in
    0) echo "  This MSP account has no Firewalla boxes in it." >/dev/tty; return 0 ;;
    1) gid="$(printf '%s' "$boxes" | jq -r '.[0].gid // empty')"
       bname="$(printf '%s' "$boxes" | jq -r '.[0].name // "?"')"
       echo "  One box on this account: ${bname}" >/dev/tty ;;
    *) cat >/dev/tty <<EOF

  This token can see ${n} Firewalla boxes. An alias reads exactly one of them,
  so pick which one '${alias}' means. (Register the others as their own aliases
  with another 'hh add-firewalla' run, using the same token.)

EOF
       printf '%s' "$boxes" | jq -r 'to_entries[] | "  \(.key + 1)) \(.value.name // "?")  (\(.value.model // "?"), \(if .value.online then "online" else "OFFLINE" end))  \(.value.gid // "?")"' >/dev/tty
       echo >/dev/tty
       while :; do
         pick="$(ask "Which box is '${alias}'? (1-${n})" 1)"
         [[ "$pick" =~ ^[0-9]+$ ]] && [ "$pick" -ge 1 ] && [ "$pick" -le "$n" ] && break
         echo "  Enter a number between 1 and ${n}." >/dev/tty
       done
       gid="$(printf '%s' "$boxes" | jq -r --argjson i "$((pick-1))" '.[$i].gid // empty')"
       bname="$(printf '%s' "$boxes" | jq -r --argjson i "$((pick-1))" '.[$i].name // "?"')"
       echo "  '${alias}' now means: ${bname}" >/dev/tty ;;
  esac
  [ -n "$gid" ] || { echo "  (the MSP returned no box id; skipping the pin)" >/dev/tty; return 0; }
  # The broker reads these; BOX is only ever for display.
  sudo sed -i '/^GID=/d;/^BOX=/d' "${REG_DIR}/${alias}.conf"
  printf 'GID=%s\nBOX=%s\n' "$gid" "$bname" | sudo tee -a "${REG_DIR}/${alias}.conf" >/dev/null
}

cmd_add_firewalla() {
  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-firewalla needs sudo (run from an admin shell, not the Claude UI)"
  cmd_add_host --platform firewalla "$@"
}

cmd_add_netbird() {
  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-netbird needs sudo (run from an admin shell, not the Claude UI)"
  cmd_add_host --platform netbird "$@"
}

cmd_add_cloudflare() {
  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-cloudflare needs sudo (run from an admin shell, not the Claude UI)"
  cmd_add_host --platform cloudflare "$@"
}

cmd_add_unifi() {
  [ "$(id -u)" -eq 0 ] || sudo -v || die "add-unifi needs sudo (run from an admin shell, not the Claude UI)"
  cmd_add_host --platform unifi "$@"
}

# Re-pin after the console's certificate legitimately changes (a firmware
# update, or installing your own cert). Separate and operator-only on purpose:
# accepting a new key is exactly what an attacker would want, so it should be a
# thing a person chooses to do, never something that happens quietly.
cmd_repin() {
  [ "$#" -eq 1 ] || die "usage: hh repin <alias>"
  local alias="$1" f="${REG_DIR}/$1.conf"
  [ -f "$f" ] || die "no such host"
  if _is_netbird "$alias"; then
    [ -n "$(conf_get "$f" PIN)" ] || die "'${alias}' is not TLS-pinned: its management server has a publicly
    trusted certificate, so ordinary verification covers it and there is no pin
    to refresh."
    [ "$(id -u)" -eq 0 ] || sudo -v || die "repin needs sudo (run from an admin shell, not the Claude UI)"
    local nhost nport npin
    nhost="$(conf_get "$f" HOST)"; nport="$(conf_get "$f" PORT)"
    npin="$(_tls_pin "$nhost" "${nport:-443}" || true)"
    [ -n "$npin" ] || die "could not read a certificate from ${nhost}:${nport}"
    sudo sed -i "/^PIN=/d" "$f"
    printf 'PIN=%s\n' "$npin" | sudo tee -a "$f" >/dev/null
    echo "Re-pinned ${alias} (${nhost})."
    cmd_test "$alias"
    return
  fi
  if ! _is_unifi "$alias"; then
    if _is_firewalla "$alias"; then
      die "'${alias}' is a Firewalla, which has no TLS pin to refresh: it is reached at
    an MSP domain with a publicly trusted certificate. If you meant to change
    WHICH BOX this alias reads, re-register it and pick again:
        hh rm-host ${alias} && hh add-firewalla"
    fi
    if _is_cloudflare "$alias"; then
      die "'${alias}' is a Cloudflare account, reached at api.cloudflare.com with a
    publicly trusted certificate. There is no pin to refresh."
    fi
    die "'${alias}' has no TLS pin to refresh. Pinning applies to a UniFi console,
    and to a self-hosted NetBird server presenting its own certificate; anything
    reached at a public endpoint is covered by ordinary CA verification."
  fi
  [ "$(id -u)" -eq 0 ] || sudo -v || die "repin needs sudo (run from an admin shell, not the Claude UI)"
  local host port pin
  host="$(conf_get "$f" HOST)"; port="$(conf_get "$f" PORT)"
  pin="$(_tls_pin "$host" "${port:-443}" || true)"
  [ -n "$pin" ] || die "could not read a certificate from ${host}:${port}"
  sudo sed -i "/^PIN=/d" "$f"
  printf 'PIN=%s\n' "$pin" | sudo tee -a "$f" >/dev/null
  echo "Re-pinned ${alias} (${host})."
  cmd_test "$alias"
}

cmd_rm_host() {
  [ "$#" -eq 1 ] || die "usage: hh rm-host <alias>"
  local f="${REG_DIR}/$1.conf"; [ -f "$f" ] || die "no such host"
  local cred; cred="$(conf_get "$f" CRED)"
  sudo rm -f "$f"
  [ -n "$cred" ] && sudo -u "$VAULT_USER" rm -f "${VAULT_DIR}/${cred}" "${VAULT_DIR}/${cred}.pub" 2>/dev/null || true
  echo "Removed $1"
}

cmd_update() {
  [ -x "$UPDATER" ] || die "updater not installed at ${UPDATER}"
  echo "Updating HomelabHero and the OS now (you will be asked for sudo)..."
  sudo "$UPDATER"
}

cmd_audit() {
  # Operator-only. The broker audit log is owned by the vault user and is
  # unreadable by the agent by design (a hijacked agent must not be able to read
  # or erase its own tracks), so reviewing it needs real sudo.
  local n="${1:-40}"
  [[ "$n" =~ ^[0-9]+$ ]] || die "usage: hh audit [lines]"
  [ -f "$BROKER_LOG" ] || die "no broker audit log yet at ${BROKER_LOG}"
  echo "Last ${n} brokered actions (time  alias  user@host:port  command):"
  sudo tail -n "$n" "$BROKER_LOG"
}

cmd_provision() {
  [ "$#" -ge 2 ] || die "usage: hh provision <alias> <host> [port] [platform] [user]"
  exec sudo -n -u "$VAULT_USER" /usr/local/bin/hh-provision "$@"
}

cmd_login() {
  local ahome; ahome="$(getent passwd "$AGENT_USER" | cut -d: -f6)"
  echo "Starting Claude Code as ${AGENT_USER}. Run /login inside, then type /exit." >/dev/tty
  # Force HOME to the agent's home (do not rely on sudo -i) and load nvm so the
  # claude binary is on PATH. Otherwise claude reads root's ~/.claude and fails.
  # ~/.local/bin goes first for the same reason the service unit puts it there:
  # a natively installed claude lives in it, and that is the one that must run.
  # Launch from the ops brain so project settings resolve there (not the caller's
  # cwd) and the homelab-ops project is registered for the web UI, skills and all.
  sudo -u "$AGENT_USER" -H bash -c "export HOME='${ahome}'; export NVM_DIR=\"\$HOME/.nvm\"; [ -s \"\$NVM_DIR/nvm.sh\" ] && . \"\$NVM_DIR/nvm.sh\"; export PATH=\"\$HOME/.local/bin:\$PATH\"; cd \"\$HOME/homelab-ops\" 2>/dev/null || cd \"\$HOME\"; exec claude"
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)      cmd_list "$@" ;;
    run)       cmd_run "$@" ;;
    test)      cmd_test "$@" ;;
    overview)  cmd_overview "$@" ;;
    inventory) cmd_inventory "$@" ;;
    diff)      cmd_diff "$@" ;;
    scan)      cmd_scan "$@" ;;
    unifi)     cmd_unifi "$@" ;;
    firewalla) cmd_firewalla "$@" ;;
    netbird)   cmd_netbird "$@" ;;
    cloudflare|cf) cmd_cloudflare "$@" ;;
    doctor)    cmd_doctor "$@" ;;
    provision) cmd_provision "$@" ;;
    add-host)  cmd_add_host "$@" ;;
    add-unifi) cmd_add_unifi "$@" ;;
    add-firewalla) cmd_add_firewalla "$@" ;;
    add-netbird)   cmd_add_netbird "$@" ;;
    add-cloudflare) cmd_add_cloudflare "$@" ;;
    repin)     cmd_repin "$@" ;;
    rm-host)   cmd_rm_host "$@" ;;
    update)    cmd_update "$@" ;;
    login)     cmd_login "$@" ;;
    audit)     cmd_audit "$@" ;;
    version|--version|-V) echo "hh (HomelabHero) ${HH_VERSION}"; echo "What changed: https://github.com/serversathome/homelabhero/blob/main/CHANGELOG.md" ;;
    ''|-h|--help|help) usage ;;
    *) die "unknown command: ${sub} (try: hh help)" ;;
  esac
}
main "$@"
